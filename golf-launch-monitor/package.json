{
  "name": "golf-launch-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first golf launch monitor and simulator with auditable measurement provenance.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "schemas:generate": "tsx scripts/generate-schemas.ts",
    "check": "npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "fake-indexeddb": "^6.2.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
