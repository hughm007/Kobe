{
  "$id": "https://golf-launch-monitor.local/schemas/glm-schema-0.1.0/sensor-configuration.schema.json",
  "title": "sensor-configuration",
  "description": "Generated from @glm/shared-types (glm-schema-0.1.0). Cross-field invariants (e.g. a null measurement value requires source 'unavailable') are enforced by the runtime zod schemas and are not all expressible in JSON Schema.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sensorId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "camera",
        "radar",
        "hybrid",
        "replay",
        "synthetic",
        "manual"
      ]
    },
    "description": {
      "type": "string"
    },
    "cameras": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cameraId": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string"
          },
          "resolution": {
            "type": "object",
            "properties": {
              "widthPx": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "heightPx": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "widthPx",
              "heightPx"
            ],
            "additionalProperties": false
          },
          "frameRateHz": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "exposureUs": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "shutter": {
            "type": "string",
            "enum": [
              "global",
              "rolling",
              "unknown"
            ]
          },
          "syncMode": {
            "type": "string",
            "enum": [
              "hardware",
              "software",
              "none"
            ]
          },
          "fixedFocus": {
            "type": "boolean"
          }
        },
        "required": [
          "cameraId",
          "model",
          "resolution",
          "frameRateHz",
          "exposureUs",
          "shutter",
          "syncMode",
          "fixedFocus"
        ],
        "additionalProperties": false
      }
    },
    "triggerSources": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "microphone",
          "beam-break",
          "ball-motion",
          "club-proximity",
          "synthetic",
          "manual"
        ]
      }
    },
    "frameBuffer": {
      "type": "object",
      "properties": {
        "preTriggerS": {
          "type": "number",
          "minimum": 0
        },
        "postTriggerS": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "preTriggerS",
        "postTriggerS"
      ],
      "additionalProperties": false
    },
    "storeRawCaptures": {
      "type": "boolean"
    }
  },
  "required": [
    "sensorId",
    "version",
    "kind",
    "description",
    "cameras",
    "triggerSources",
    "frameBuffer",
    "storeRawCaptures"
  ],
  "additionalProperties": false
}
