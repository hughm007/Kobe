# Copy to `.env` and fill in. `.env` is git-ignored — never commit a real key,
# and never paste one into a source file, even temporarily. (AGENT.md §5)

# The brain. Required for every tier.
ANTHROPIC_API_KEY=sk-ant-...

# The ears. Required only for /voice (Tier 3).
DEEPGRAM_API_KEY=

# The mouth. Required only for /voice (Tier 3).
ELEVENLABS_API_KEY=

# Set to "fake" to run the whole harness against a scripted provider with no
# API key and no network — how the test suite runs.
# ORION_PROVIDER=fake
